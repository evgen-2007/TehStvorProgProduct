<Window x:Class="MyDentalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Стоматологія MyDentalApp" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}" Margin="5,0,0,0" 
                                       Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="Center"
                                       Visibility="Collapsed" x:Name="WatermarkText"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F2F5">
        <Border x:Name="LoginPanel" Background="White" CornerRadius="15" Width="350" Height="300" VerticalAlignment="Center">
            <StackPanel Margin="30">
                <TextBlock Text="Вхід у систему" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <PasswordBox x:Name="UserPasswordBox" Height="35" Margin="0,0,0,20"/>
                <Button Content="Увійти" Height="40" Background="#3498DB" Foreground="White" Click="LoginButton_Click"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainControl" Visibility="Collapsed" Margin="10">
            <TabItem Header="Пацієнти">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    
                    <DataGrid x:Name="PatientsGrid" Margin="10" AutoGenerateColumns="True" IsReadOnly="True"/>
                    
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="Новий пацієнт" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtLastName" Tag="Прізвище..."/>
                        <TextBox x:Name="TxtGender" Tag="Стать (Ч/Ж)..."/>
                        <TextBox x:Name="TxtAge" Tag="Вік..."/>
                        <TextBox x:Name="TxtCity" Tag="Місто..."/>
                        <TextBox x:Name="TxtDiagnosis" Tag="Діагноз..."/>
                        <Button Content="Додати" Click="AddPatient_Click" Margin="0,10" Background="#3498DB" Foreground="White" Height="35"/>
                        <Button Content="Оновити таблицю" Click="RefreshData_Click" Height="30"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Генерація звіту">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">
                    <TextBlock Text="Параметри звіту" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    
                    <Label Content="Мінімальний вік:"/>
                    <TextBox x:Name="AgeLimitInput" Tag="Наприклад: 18"/>
                    
                    <Label Content="Діагноз для відбору:"/>
                    <TextBox x:Name="DiagFilterInput" Tag="Наприклад: Карієс"/>
                    
                    <Button Content="Зберегти звіт (.txt)" Click="GenerateWordReport_Click" 
                            Height="50" Margin="0,20" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>