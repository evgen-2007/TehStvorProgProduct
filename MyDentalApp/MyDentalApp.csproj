<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Встановлює іконку для самого .exe файлу -->
    <ApplicationIcon>clinic.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.0.0" />
    <PackageReference Include="DocX" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Критично важливо для відображення іконки в інтерфейсі -->
    <Resource Include="clinic.png" />
    <Resource Include="clinic.ico" />
  </ItemGroup>

</Project>