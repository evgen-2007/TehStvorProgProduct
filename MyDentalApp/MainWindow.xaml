<Window x:Class="MyDentalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dental Report - Робоче місце лікаря" Height="700" Width="950"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Grid>
        <Border x:Name="LoginPanel" Visibility="Visible" Width="360" Height="370" 
                Background="White" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <Image Source="pack://application:,,,/clinic.png" Height="50" Width="50" HorizontalAlignment="Center" Margin="0,0,0,10" Stretch="Uniform"/>
                
                <TextBlock Text="Авторизація" FontSize="22" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#212529"/>
                
                <TextBlock Text="Прізвище співробітника:" Margin="0,5,0,2" Foreground="#495057"/>
                <TextBox x:Name="UserLoginBox" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                
                <TextBlock Text="Пароль:" Margin="0,10,0,2" Foreground="#495057"/>
                <PasswordBox x:Name="UserPasswordBox" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                
                <Button Content="Увійти в систему" Click="LoginButton_Click" Height="35" Margin="0,20,0,12" 
                        Background="#007BFF" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                
                <TextBlock Text="Зареєструвати нового співробітника" MouseLeftButtonDown="ShowRegisterPanel_Click" 
                           HorizontalAlignment="Center" Foreground="#007BFF" Cursor="Hand" Margin="0,5,0,0" 
                           TextDecorations="Underline" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border x:Name="RegisterPanel" Visibility="Collapsed" Width="380" Height="440" 
                Background="White" CornerRadius="12" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <Image Source="pack://application:,,,/clinic.png" Height="45" Width="45" HorizontalAlignment="Center" Margin="0,0,0,8" Stretch="Uniform"/>
                
                <TextBlock Text="Реєстрація персоналу" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="#212529"/>
                
                <TextBlock Text="Прізвище:" Margin="0,3,0,2"/>
                <TextBox x:Name="RegSur" Height="28" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Ім'я:" Margin="0,8,0,2"/>
                <TextBox x:Name="RegName" Height="28" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Посада (напр. Лікар-стоматолог):" Margin="0,8,0,2"/>
                <TextBox x:Name="RegPos" Height="28" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Пароль:" Margin="0,8,0,2"/>
                <PasswordBox x:Name="RegPass" Height="28" VerticalContentAlignment="Center"/>
                
                <Button Content="Зареєструвати" Click="SaveUser_Click" Height="32" Margin="0,15,0,10" 
                        Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                
                <TextBlock Text="Назад до авторизації" MouseLeftButtonDown="ShowLoginPanel_Click" 
                           HorizontalAlignment="Center" Foreground="#6C757D" Cursor="Hand" Margin="0,5,0,0" TextDecorations="Underline"/>
            </StackPanel>
        </Border>

        <Grid x:Name="MainControl" Visibility="Collapsed" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Cursor="Hand" MouseLeftButtonDown="ChangeAvatar_Click" ToolTip="Натисніть, щоб змінити аватарку">
                            <Ellipse x:Name="UserAvatarCircle" Width="52" Height="52" Stroke="#007BFF" StrokeThickness="2">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="pack://application:,,,/clinic.png" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Background="#80000000" CornerRadius="10" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                <TextBlock Text="✏️" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserFullName" Text="Прізвище Ім'я" FontSize="16" Foreground="#212529" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtUserPosition" Text="Посада" FontSize="13" Foreground="#6C757D" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Вийти з акаунту" Click="LogoutButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" 
                            Padding="12,6" Background="#DC3545" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <GroupBox x:Name="GroupPatientForm" Header="Реєстрація нового пацієнта" Grid.Row="1" Margin="0,0,0,10" Padding="8" FontWeight="Bold" Foreground="#444">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPatientId" Visibility="Collapsed"/>
                    
                    <StackPanel Margin="5">
                        <TextBlock Text="Прізвище:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtLastName" Width="140" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="5">
                        <TextBlock Text="Стать:" FontWeight="Normal"/>
                        <ComboBox x:Name="ComboGender" Width="60" Height="26" SelectedIndex="0" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Ч"/>
                            <ComboBoxItem Content="Ж"/>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Margin="5">
                        <TextBlock Text="Вік:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtAge" Width="50" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="5">
                        <TextBlock Text="Місто:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtCity" Width="120" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="5">
                        <TextBlock Text="Діагноз:" FontWeight="Normal"/>
                        <TextBox x:Name="TxtDiagnosis" Width="200" Height="26" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnSavePatient" Content="Додати пацієнта" Click="AddOrUpdatePatient_Click" VerticalAlignment="Bottom" Margin="10,5" Width="130" Height="26" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button x:Name="BtnCancelEdit" Content="Скасувати" Click="CancelEdit_Click" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="5,5" Width="80" Height="26" Background="#6C757D" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                </WrapPanel>
            </GroupBox>

            <Border Grid.Row="2" Background="#E9ECEF" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Пошук за прізвищем: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#495057"/>
                    <TextBox x:Name="TxtSearchLastName" Width="220" Height="26" VerticalContentAlignment="Center" Padding="5,0"/>
                    <Button Content="Знайти" Click="SearchPatient_Click" Margin="10,0,0,0" Padding="15,0" Height="26" Background="#007BFF" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                    <Button Content="❌ Скинути" Click="ClearSearch_Click" Margin="5,0,0,0" Padding="10,0" Height="26"/>
                </StackPanel>
            </Border>

            <DataGrid x:Name="PatientsGrid" Grid.Row="3" AutoGenerateColumns="False" GridLinesVisibility="All" 
                      VerticalGridLinesBrush="#E0E0E0" HorizontalGridLinesBrush="#E0E0E0" IsReadOnly="True" 
                      Background="White" RowHeight="28" AlternatingRowBackground="#F9FAFB"
                      SelectionChanged="PatientsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding №}" Width="50"/>
                    <DataGridTextColumn Header="Прізвище" Binding="{Binding Прізвище}" Width="150"/>
                    <DataGridTextColumn Header="Стать" Binding="{Binding Стать}" Width="60"/>
                    <DataGridTextColumn Header="Вік" Binding="{Binding Вік}" Width="60"/>
                    <DataGridTextColumn Header="Місто" Binding="{Binding Місто}" Width="130"/>
                    <DataGridTextColumn Header="Діагноз" Binding="{Binding Діагноз}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Фільтр віку від:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox x:Name="AgeLimitInput" Width="40" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                    <TextBlock Text="Діагноз:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <ComboBox x:Name="DiagFilterCombo" Width="180" Height="26" VerticalContentAlignment="Center"/>

                    <Button Content="Застосувати фільтр" Click="ApplyFilter_Click" Margin="10,0,0,0" Padding="10,0" Background="#17A2B8" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
                    <Button Content="Скинути" Click="ResetFilter_Click" Margin="5,0,0,0" Padding="10,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 Оновити таблицю" Click="RefreshData_Click" Padding="10,5" Margin="5,0"/>
                    <Button Content="📋 Згенерувати звіт (.txt)" Click="GenerateTxtReport_Click" Padding="12,5" Background="#28A745" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="⚠️ Видалити весь персонал" Click="ClearUsers_Click" Padding="10,5" Background="#6C757D" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
